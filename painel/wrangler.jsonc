// Configuração do painel na Cloudflare (Worker + D1 + R2).
// O banco (D1) e o lugar dos arquivos (R2) ficam na conta da Cloudflare do Kaique.
// Pra rodar no computador, o wrangler dev simula os dois localmente (pasta .wrangler/).
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "painel-okaiquemota",
    "main": "src/worker.js",
    "compatibility_date": "2026-09-01",
    "workers_dev": true,
    "preview_urls": false,
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        // tudo passa pelo worker primeiro, pra levar os cabeçalhos de segurança
        "run_worker_first": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "painel-okaiquemota",
            "database_id": "31347bca-c1a8-4742-b628-7d20533f2740",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        {
            "binding": "ARQUIVOS",
            "bucket_name": "painel-okaiquemota"
        }
    ],
    "observability": {
        "enabled": true
    }
}
